    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.2.3",
    "@matter/main": "^0.17.9",
    "@matter/nodejs": "^0.17.9",
