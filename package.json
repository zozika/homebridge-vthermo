{
  "name": "homebridge-vthermo",
  "displayName": "Homebridge Vthermo",
  "type": "module",
  "version": "2.3.2",
  "description": "Virtual thermostat for Homebridge that reads Matter temperature/contact sensors and switches a Matter On/Off relay.",
  "author": "palmaiz",
  "license": "MIT",
  "homepage": "https://github.com/zozika/homebridge-vthermo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zozika/homebridge-vthermo.git"
  },
  "bugs": {
    "url": "https://github.com/zozika/homebridge-vthermo/issues"
  },
  "funding": {
    "type": "buymeacoffee",
    "url": "https://www.buymeacoffee.com/palmaiz"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "homebridge-ui",
    "config.schema.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "homebridge-plugin",
    "homebridge",
    "thermostat",
    "virtual-thermostat",
    "matter"
  ],
  "engines": {
    "node": "^20.18.0 || ^22.10.0 || ^24.0.0",
