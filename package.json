    "@matter/types": "^0.17.9",
    "fakegato-history": "^0.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "homebridge": "^2.4.0",
    "rimraf": "^6.1.0",
    "typescript": "^5.9.3"
  }
